# CampusFlow 环境变量模板：复制为 .env 并按需修改（不含真实密钥，允许提交）
# SQLite 本地数据库文件路径（相对项目根目录）
DATABASE_URL="file:./prisma/dev.db"

# ---------- AI Provider（S6） ----------
# mock：使用规则引擎的 MockAIProvider（开发 / 离线演示，推荐默认）
# real：使用 OpenAI-compatible HTTP 接口的真实模型（必须补齐下面三项）
AI_PROVIDER=mock

# 真实模型配置：只在 AI_PROVIDER=real 时读取
# 只允许服务端使用，禁止加 NEXT_PUBLIC_ 前缀
REAL_LLM_BASE_URL=
REAL_LLM_API_KEY=
REAL_LLM_MODEL=

# 请求超时（毫秒），可选，默认 30000
REAL_LLM_TIMEOUT_MS=30000
